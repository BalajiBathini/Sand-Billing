<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Application Category for Sand Billing -->
        <record model="ir.module.category" id="module_category_sand_billing">
            <field name="name">Sand Billing</field>
            <field name="description">Helps you manage Sand Billing</field>
            <field name="sequence">20</field>
        </record>

        <!-- Sand Billing User Group -->
        <record id="group_sand_user" model="res.groups">
            <field name="name">Sand Billing User</field>
            <field name="category_id" ref="module_category_sand_billing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will have access to his own data within the Sand Billing application.</field>
        </record>

        <!-- Sand Billing Manager Group -->
        <record id="group_sand_manager" model="res.groups">
            <field name="name">Sand Admin</field>
            <field name="category_id" ref="module_category_sand_billing"/>
            <field name="implied_ids" eval="[(4, ref('sand_billing.group_sand_user'))]"/>
            <field name="comment">The user will have access to all data within the Sand Billing application.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Rule: Users see their own receipts -->
        <record id="sand_billing_receipt_rule_personal" model="ir.rule">
            <field name="name">Personal Sand Billing Receipts</field>
            <field name="model_id" ref="model_sand_billing_receipt"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sand_billing.group_sand_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule: Admins see all receipts -->
        <record id="sand_billing_receipt_rule_all" model="ir.rule">
            <field name="name">All Sand Billing Receipts</field>
            <field name="model_id" ref="model_sand_billing_receipt"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('sand_billing.group_sand_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
