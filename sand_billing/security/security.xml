<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================
         Security Groups
         ========================= -->
    <record id="group_sand_user" model="res.groups">
        <field name="name">Sand Billing User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            User can access only his own Sand Billing records.
        </field>
    </record>

    <record id="group_sand_manager" model="res.groups">
        <field name="name">Sand Admin</field>
        <field name="implied_ids" eval="[(4, ref('sand_billing.group_sand_user'))]"/>
        <field name="comment">
            Administrator can access all Sand Billing records.
        </field>
    </record>

    <!-- =========================
         Record Rule - User
         ========================= -->
    <record id="sand_billing_receipt_rule_personal" model="ir.rule">
        <field name="name">User Own Receipts Only (Last 1 Hour)</field>
        <field name="model_id" ref="model_sand_billing_receipt"/>
        <field name="domain_force">
            [('user_id', '=', user.id), ('create_date', '&gt;=', time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(time.time() - 3600)))]
        </field>
        <field name="groups" eval="[(4, ref('sand_billing.group_sand_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- =========================
         Record Rule - Admin
         ========================= -->
    <record id="sand_billing_receipt_rule_admin" model="ir.rule">
        <field name="name">Admin Access All Receipts</field>
        <field name="model_id" ref="model_sand_billing_receipt"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('sand_billing.group_sand_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
