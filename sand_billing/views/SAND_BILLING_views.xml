<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="SAND_BILLING_receipt_list" model="ir.ui.view">
        <field name="name">sand.billing.receipt.list</field>
        <field name="model">sand.billing.receipt</field>
        <field name="arch" type="xml">
            <list string="Sand Billing Receipts">
                <field name="receipt_id" optional="hide"/>
                <field name="order_id" optional="hide"/>

                <field name="customer_name"/>
                <field name="sand_quantity"/>
                <field name="state"/>
                <field name="vehicle_no"/>
                <field name="driver_name"/>
                <field name="driver_phone"/>
                <field name="created_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="SAND_BILLING_receipt_form" model="ir.ui.view">
        <field name="name">sand.billing.receipt.form</field>
        <field name="model">sand.billing.receipt</field>
        <field name="arch" type="xml">
            <form string="Sand Billing Receipt">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_print_receipt" type="object" string="Generate Receipt" class="oe_highlight"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"/>
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="receipt_id" readonly="1" invisible="1"/>
                            <field name="order_id" placeholder="Registration ID"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Consumer Information">
                            <field name="customer_name"/>
                            <field name="customer_mobile"/>
                            <field name="registration_date"/>
                            <field name="registration_type"/>
                            <field name="registration_qty"/>
                            <field name="registration_address"/>
                        </group>

                    </group>

                    <separator string="Sand Availability"/>
                    <group>
                        <group>
                            <field name="available_sand_qty"/>
                            <field name="sand_supply_point"/>
                            <field name="construction_name"/>
                        </group>
                        <group>
                            <field name="eligible_sand_qty" readonly="1" force_save="1"/>
                        </group>
                    </group>

                    <separator string="Dispatch Information"/>
                    <group>
                        <group>
                            <field name="dispatch_id"/>
                            <field name="hologram_id"/>
                            <field name="trip_no"/>
                            <field name="vehicle_no"/>
                            <field name="vehicle_type"/>
                            <field name="driver_name"/>
                            <field name="driver_phone"/>
                        </group>
                        <group>
                            <field name="dispatch_qty"/>
                            <field name="dispatch_date"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="SAND_BILLING_receipt_search" model="ir.ui.view">
        <field name="name">sand.billing.receipt.search</field>
        <field name="model">sand.billing.receipt</field>
        <field name="arch" type="xml">
            <search string="Sand Billing Receipt">
                <field name="receipt_id"/>
                <field name="order_id"/>
                <field name="trip_no"/>
                <field name="customer_name"/>
                <field name="driver_name"/>
                <field name="dispatch_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Printed" name="printed" domain="[('state', '=', 'printed')]"/>
                <separator/>
                <filter string="Recent (Last 1 Hour)" name="recent" domain="[('is_recent', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_SAND_BILLING_receipt" model="ir.actions.act_window">
        <field name="name">Sand Billing Receipt</field>
        <field name="res_model">sand.billing.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_recent': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sand billing receipt here!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
            id="menu_SAND_BILLING_root"
            name="Sand Billing"
            groups="sand_billing.group_sand_user,sand_billing.group_sand_manager"
            sequence="1"/>

    <menuitem
            id="menu_SAND_BILLING_receipt"
            name="Billing Receipts"
            action="action_SAND_BILLING_receipt"
            parent="menu_SAND_BILLING_root"
            sequence="1"/>

    <!-- Move Paper Format menu under Sand Billing -> Only visible to Sand Manager / System Admin -->
    <menuitem
            id="base.paper_format_menuitem"
            parent="menu_SAND_BILLING_root"
            name="paper format"
            groups="sand_billing.group_sand_manager,base.group_system"
            sequence="99"/>

</odoo>



