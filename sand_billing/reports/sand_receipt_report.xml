<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Define 80mm Thermal Paper Format -->
        <record id="paperformat_sand_thermal_80mm" model="report.paperformat">
            <field name="name">Sand Thermal 80mm</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">297</field>
            <field name="page_width">80</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">2</field>
            <field name="margin_bottom">2</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_sand_receipt_report" model="ir.actions.report">
            <field name="name">Sand Receipt</field>
            <field name="model">sand.billing.receipt</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">sand_billing.report_sand_receipt_html</field>
            <field name="binding_model_id" ref="model_sand_billing_receipt"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_sand_receipt_report_pdf" model="ir.actions.report">
            <field name="name">Sand Receipt PDF</field>
            <field name="model">sand.billing.receipt</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sand_billing.report_sand_receipt</field>
            <field name="binding_model_id" ref="model_sand_billing_receipt"/>
            <field name="paperformat_id" ref="paperformat_sand_thermal_80mm"/>
        </record>
    </data>
</odoo>
