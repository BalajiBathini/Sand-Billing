                                <td style="vertical-align: middle; text-align: left;">
                                    <div style="font-size: 13pt; font-weight: bold;">AP SAND</div>
                                    <div style="font-size: 9pt; font-weight: bold;">MANAGEMENT SYSTEM</div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="text-align: center; margin-bottom: 3mm;">
                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 50%; text-align: left; vertical-align: middle; padding-left: 2mm; font-size: 10pt; font-weight: bold;">
                                    Transit Copy
                                </td>
                                <td style="width: 50%; text-align: center; vertical-align: middle;">
                                    <div style="display: inline-block; border: 1px solid #000; border-radius: 4px; padding: 2px 4px; font-weight: bold; font-family: sans-serif; font-size: 7.5pt; text-align: center; line-height: 1.1;">
                                        Stick<br/>HOLOGRAM<br/>Here
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Details -->
                    <div style="font-size: 8pt; margin-bottom: 2mm; line-height: 1.5;">
