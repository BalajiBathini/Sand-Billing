                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.order_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Trip No
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.trip_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Customer Name
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.customer_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Customer Mobile
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.customer_mobile"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Sand Quantity
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="'{:.1f}'.format(doc.dispatch_qty)"/> Tons
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Supply Point
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.sand_supply_point"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Dispatch Date
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc._get_ist_time_str('dispatch_date')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Driver Name
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.driver_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Driver Mobile
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.driver_phone"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Vehicle No
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.vehicle_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Address
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right; width: 50%; word-wrap: break-word; word-break: break-all; white-space: normal; max-width: 35mm;">
                                    <t t-out="doc.address"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- QR Code -->
                    <div style="text-align: center; margin: 2mm 0;">
                        <img t-if="doc.qr_code" t-attf-src="data:image/png;base64,{{doc.qr_code}}"
                             style="max-width: 35mm; height: auto;" alt="QR Code"/>
                    </div>

                    <!-- Coordinates if any, optional placeholder or anything -->
                    <div style="text-align: center; font-size: 8pt; margin-top: 1mm;">
                        <t t-if="doc.gps_coordinates">
                            <t t-out="doc.gps_coordinates"/>
                        </t>
                        <t t-else="">14.6843324,78.0257817</t>
                    </div>

                    <div style="text-align: center; font-weight: bold; font-size: 8pt; margin-top: 1mm;">
                        Thank You
                    </div>
                </div>
            </div>
        </t>
