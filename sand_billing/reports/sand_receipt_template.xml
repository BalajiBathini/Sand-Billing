                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Hologram Id
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.dispatch_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Order Id
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.order_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Trip No
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.trip_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Customer Name
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.customer_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Customer Mobile
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.customer_mobile"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Sand Quantity
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="'{:.1f}'.format(doc.dispatch_qty)"/> Tons
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Supply Point
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.sand_supply_point"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Dispatch Date
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc._get_ist_time_str('dispatch_date')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 1mm; font-weight: 500;">
                                    Driver Name
                                </td>
                                <td style="padding: 1mm; text-align: center;">:</td>
                                <td style="padding: 1mm; text-align: right;">
                                    <t t-out="doc.driver_name"/>
                                </td>
