<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_sand_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sand_billing.report_sand_receipt_document"/>
            </t>
        </t>
    </template>

    <template id="report_sand_receipt_html">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sand_billing.report_sand_receipt_document_html"/>
            </t>
        </t>
    </template>

    <!-- PDF Template - Simple Thermal Receipt Format -->
    <template id="report_sand_receipt_document">
        <t t-call="web.basic_layout">
            <div class="page"
                 style="max-width: 80mm; margin: 0 auto; padding: 0; font-family: math; font-size: 9pt; line-height: 1.3;">

                <!-- CONSUMER COPY -->
                <div style="margin-bottom: 0;">
                    <!-- Header -->
                    <div style="margin-bottom: 4mm; text-align: center;">
                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 20mm; vertical-align: top; text-align: right; padding-right: 2mm;">
                                    <t t-if="doc.company_id.logo">
                                        <img t-attf-src="data:image/png;base64,{{doc.company_id.logo}}"
                                             style="max-width: 15mm; height: auto;" alt="Logo"/>
                                    </t>
                                </td>
                                <td style="vertical-align: middle; text-align: left;">
                                    <div style="font-size: 13pt; font-weight: bold;">AP SAND</div>
                                    <div style="font-size: 9pt; font-weight: bold;">MANAGEMENT SYSTEM</div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="text-align: center; margin-bottom: 3mm; font-weight: bold; font-size: 10pt;">
