<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_device_login_history_list" model="ir.ui.view">
        <field name="name">device.login.history.list</field>
        <field name="model">device.login.history</field>
        <field name="arch" type="xml">
            <list string="Login History"
                  decoration-success="login_status == 'success'"
                  decoration-danger="login_status in ('blocked', 'rejected', 'failed')"
                  default_order="login_date desc"
                  create="false" edit="false" delete="false">
                <field name="login_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="device_id"/>
                <field name="browser"/>
                <field name="os_name"/>
                <field name="ip_address"/>
                <field name="login_status" widget="badge"
                       decoration-success="login_status == 'success'"
                       decoration-warning="login_status == 'blocked'"
                       decoration-danger="login_status in ('rejected', 'failed')"/>
            </list>
        </field>
    </record>

    <record id="view_device_login_history_search" model="ir.ui.view">
        <field name="name">device.login.history.search</field>
        <field name="model">device.login.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="ip_address"/>
                <filter name="success" string="Successful"
                        domain="[('login_status','=','success')]"/>
                <filter name="blocked" string="Blocked"
                        domain="[('login_status','in',['blocked','rejected'])]"/>
                <filter name="today" string="Today"
                        domain="[('login_date','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'login_status'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'login_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_device_login_history" model="ir.actions.act_window">
        <field name="name">Login History</field>
        <field name="res_model">device.login.history</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
