<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_users_device_approval_form" model="ir.ui.view">
        <field name="name">res.users.device.approval.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Add stat buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        name="action_view_devices"
                        type="object"
                        icon="fa-desktop">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="approved_device_count"/>
                        </span>
                        <span class="o_stat_text">Devices</span>
                    </div>
                </button>
                <button class="oe_stat_button"
                        name="action_view_devices"
                        type="object"
                        icon="fa-clock-o"
                        invisible="pending_device_count == 0">
                    <div class="o_stat_info o_field_widget">
                        <span class="o_stat_value text-warning">
                            <field name="pending_device_count"/>
                        </span>
                        <span class="o_stat_text">Pending</span>
                    </div>
                </button>
            </xpath>
            <!-- Add device approval toggle to Preferences tab -->
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Device Security" groups="base.group_system">
                    <field name="device_approval_enabled"
                           widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
