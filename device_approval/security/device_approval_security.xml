<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Record rule: users can only see their own devices -->
        <record id="rule_res_user_device_user" model="ir.rule">
            <field name="name">User Device: Own Devices Only</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Admins see all devices -->
        <record id="rule_res_user_device_admin" model="ir.rule">
            <field name="name">User Device: Admin Sees All</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Login history: users see own records -->
        <record id="rule_device_login_history_user" model="ir.rule">
            <field name="name">Login History: Own Records Only</field>
            <field name="model_id" ref="model_device_login_history"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
    </data>
</odoo>
