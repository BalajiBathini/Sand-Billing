<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── New Device Pending (to Admin) ───────────────────────────────── -->
        <record id="mail_template_device_pending" model="mail.template">
            <field name="name">Device Approval: New Device Pending</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="subject">⚠️ New Device Login Request – {{ object.user_id.name }}</field>
            <field name="email_to">{{ object.env['res.users'].search([('groups_id','in',[object.env.ref('base.group_system').id])]).mapped('email') | join(',') }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#f8f9fa;padding:20px;border-radius:8px;">
    <div style="background:#dc3545;color:#fff;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">🔔 New Device Login Attempt</h2>
    </div>
    <div style="background:#fff;padding:24px;border:1px solid #dee2e6;border-top:none;border-radius:0 0 6px 6px;">
        <p>A login attempt was made from a <strong>new unrecognized device</strong>. Please review and approve or reject it.</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;width:40%;border:1px solid #dee2e6;">User</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.user_id.name }} ({{ object.user_id.login }})</td>
            </tr>
            <tr>
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Device</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.device_name }}</td>
            </tr>
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Browser</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.browser }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Operating System</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.os_name }}</td>
            </tr>
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">IP Address</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.ip_address }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Date/Time</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.create_date }}</td>
            </tr>
        </table>
        <div style="text-align:center;margin-top:24px;">
            <a href="{{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/odoo/device-approvals"
               style="background:#28a745;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-weight:bold;display:inline-block;">
                Review in Odoo →
            </a>
        </div>
    </div>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

        <!-- ── Device Approved (to User) ───────────────────────────────────── -->
        <record id="mail_template_device_approved" model="mail.template">
            <field name="name">Device Approval: Device Approved</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="subject">✅ Your device has been approved – {{ object.device_name }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#f8f9fa;padding:20px;border-radius:8px;">
    <div style="background:#28a745;color:#fff;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">✅ Device Approved</h2>
    </div>
    <div style="background:#fff;padding:24px;border:1px solid #dee2e6;border-top:none;border-radius:0 0 6px 6px;">
        <p>Dear {{ object.user_id.name }},</p>
        <p>Your device has been <strong>approved</strong>. You can now log in from this device.</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Device</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.device_name }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Browser</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.browser }}</td>
            </tr>
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Approved By</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.approved_by.name }}</td>
            </tr>
        </table>
    </div>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

        <!-- ── Device Rejected (to User) ───────────────────────────────────── -->
        <record id="mail_template_device_rejected" model="mail.template">
            <field name="name">Device Approval: Device Rejected</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="subject">❌ Device access rejected – {{ object.device_name }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#f8f9fa;padding:20px;border-radius:8px;">
    <div style="background:#dc3545;color:#fff;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">❌ Device Access Rejected</h2>
    </div>
    <div style="background:#fff;padding:24px;border:1px solid #dee2e6;border-top:none;border-radius:0 0 6px 6px;">
        <p>Dear {{ object.user_id.name }},</p>
        <p>Your login request from the following device has been <strong>rejected</strong>:</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Device</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.device_name }}</td>
            </tr>
            <tr>
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Reason</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.rejection_reason or 'Not specified' }}</td>
            </tr>
        </table>
        <p>Please contact your administrator if you believe this is a mistake.</p>
    </div>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

        <!-- ── Device Revoked (to User) ────────────────────────────────────── -->
        <record id="mail_template_device_revoked" model="mail.template">
            <field name="name">Device Approval: Device Revoked</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="subject">⚠️ Device access revoked – {{ object.device_name }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#f8f9fa;padding:20px;border-radius:8px;">
    <div style="background:#ffc107;color:#212529;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">⚠️ Device Access Revoked</h2>
    </div>
    <div style="background:#fff;padding:24px;border:1px solid #dee2e6;border-top:none;border-radius:0 0 6px 6px;">
        <p>Dear {{ object.user_id.name }},</p>
        <p>Access from the following device has been <strong>revoked</strong>:</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#f8f9fa;">
                <td style="padding:8px 12px;font-weight:bold;border:1px solid #dee2e6;">Device</td>
                <td style="padding:8px 12px;border:1px solid #dee2e6;">{{ object.device_name }}</td>
            </tr>
        </table>
        <p>You will no longer be able to log in from this device. Please contact your administrator.</p>
    </div>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

        <!-- ── OTP Email ────────────────────────────────────────────────────── -->
        <record id="mail_template_device_otp" model="mail.template">
            <field name="name">Device Approval: OTP Verification</field>
            <field name="model_id" ref="model_res_user_device"/>
            <field name="subject">🔐 Your device verification code – {{ object.otp_code }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#f8f9fa;padding:20px;border-radius:8px;">
    <div style="background:#007bff;color:#fff;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">🔐 Device Verification Code</h2>
    </div>
    <div style="background:#fff;padding:24px;border:1px solid #dee2e6;border-top:none;border-radius:0 0 6px 6px;">
        <p>Dear {{ object.user_id.name }},</p>
        <p>Use the following OTP to verify your device:</p>
        <div style="text-align:center;margin:24px 0;">
            <span style="font-size:36px;font-weight:bold;letter-spacing:8px;color:#007bff;background:#e7f3ff;padding:16px 32px;border-radius:8px;display:inline-block;">
                {{ object.otp_code }}
            </span>
        </div>
        <p style="color:#6c757d;font-size:13px;">This code expires in 15 minutes. If you did not request this, please ignore this email and contact your administrator.</p>
    </div>
</div>
            ]]></field>
            <field name="auto_delete">True</field>
        </record>

    </data>
</odoo>
