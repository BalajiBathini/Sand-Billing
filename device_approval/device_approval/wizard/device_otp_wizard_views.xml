<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Reject Wizard ─────────────────────────────────────────────────── -->
    <record id="view_device_reject_wizard_form" model="ir.ui.view">
        <field name="name">device.reject.wizard.form</field>
        <field name="model">device.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Device">
                <group>
                    <field name="device_id" readonly="1"
                           widget="many2one"/>
                    <field name="rejection_reason" required="1"
                           placeholder="Please explain why this device is being rejected..."
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Confirm Rejection" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── OTP Wizard ────────────────────────────────────────────────────── -->
    <record id="view_device_otp_wizard_form" model="ir.ui.view">
        <field name="name">device.otp.wizard.form</field>
        <field name="model">device.otp.wizard</field>
        <field name="arch" type="xml">
            <form string="Verify OTP">
                <group>
                    <field name="device_id"/>
                    <field name="otp_code"
                           placeholder="Enter 6-digit code"
                           widget="char"/>
                </group>
                <footer>
                    <button name="action_verify_otp" type="object"
                            string="Verify &amp; Approve" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
